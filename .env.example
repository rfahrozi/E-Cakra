# E-CAKRA Environment Variables
# Salin file ini ke .env dan isi nilai yang sesuai

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=ecakra
POSTGRES_USER=ecakra
POSTGRES_PASSWORD=ganti_dengan_password_aman

# ── Backend ───────────────────────────────────────────────
DATABASE_URL=postgresql://ecakra:ganti_dengan_password_aman@db:5432/ecakra
SECRET_KEY=ganti_dengan_secret_key_panjang_acak
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── Zoom API (Server-to-Server OAuth) ─────────────────────
ZOOM_ACCOUNT_ID=isi_zoom_account_id
ZOOM_CLIENT_ID=isi_zoom_client_id
ZOOM_CLIENT_SECRET=isi_zoom_client_secret
ZOOM_WEBHOOK_SECRET_TOKEN=isi_zoom_webhook_secret_token
ZOOM_HOST_USER_ID=email_host_zoom@domain.com

# ── Aplikasi ──────────────────────────────────────────────
APP_NAME=E-CAKRA
APP_ENV=development
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost/api
VITE_APP_NAME=E-CAKRA
VITE_APP_VERSION=1.0.0
